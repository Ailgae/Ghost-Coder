{
  "name": "ghost-coder",
  "version": "1.0.0",
  "description": "A coding assistant application built with Electron.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --dir",
    "dist": "electron-builder build",
    "test": "mocha \"tests/**/*.test.js\""
  },
  "author": "Eugene",
  "license": "ISC",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "mocha": "^11.7.6"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  },
  "build": {
    "appId": "com.example.ghostcoder",
    "productName": "GhostCoder",
    "directories": {
      "output": "dist/"
    },
    "files": [
      "agent/**/*",
      "assets/**/*",
      "renderer/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.png"
    },
    "win": {
      "icon": "assets/icon.png"
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  }
}
